{
  "name": "miniapp-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:mp-weixin": "uni build -p mp-weixin",
    "dev:h5": "uni",
    "build:h5": "uni build",
    "test": "node --test tests/*.test.js",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs --check",
    "format:frontend": "node scripts/format.mjs --write --frontend-only",
    "format:backend": "node scripts/format.mjs --write --backend-only",
    "dev:admin": "vite --config admin-web/vite.config.js",
    "build:admin": "vite build --config admin-web/vite.config.js"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5030420261029002",
    "@dcloudio/uni-components": "3.0.0-5030420261029002",
    "@dcloudio/uni-h5": "3.0.0-5030420261029002",
    "@dcloudio/uni-mp-weixin": "3.0.0-5030420261029002",
    "vue": "^3.4.21",
    "vue-i18n": "^9.1.9"
  },
  "devDependencies": {
    "@dcloudio/uni-cli-shared": "3.0.0-5030420261029002",
    "@dcloudio/uni-stacktracey": "3.0.0-5030420261029002",
    "@dcloudio/vite-plugin-uni": "3.0.0-5030420261029002",
    "@prettier/plugin-xml": "3.4.2",
    "prettier": "3.10.1",
    "prettier-plugin-java": "2.12.0",
    "rollup": "4.14.3",
    "sql-formatter": "15.9.0",
    "vite": "5.2.8"
  },
  "engines": {
    "node": ">=20"
  }
}
