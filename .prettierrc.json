{
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "es5",
  "arrowParens": "avoid",
  "singleAttributePerLine": true,
  "bracketSameLine": false,
  "htmlWhitespaceSensitivity": "ignore",
  "endOfLine": "lf",
  "plugins": ["prettier-plugin-java", "@prettier/plugin-xml"],
  "overrides": [
    {
      "files": ["*.java", "*.xml"],
      "options": {
        "tabWidth": 4
      }
    },
    {
      "files": "*.xml",
      "options": {
        "xmlWhitespaceSensitivity": "ignore"
      }
    }
  ]
}
